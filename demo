#!/bin/sh
# Boots the Rev 2 flight firmware (app/rev2, STM32H743 stand-in) on the simulator with Python sensor peers replaying
# locked_in_flight.csv, and streams every log channel the firmware has while it runs (see sim/demo_view.py):
# sim trace hits, the firmware's debug_log messages (at the end), the first I2C bus frames, and the flight log it writes to flash.
# Needs `sim` on PATH (or SIM=/path/to/sim) and sim/build.sh done. Full run and plots: see sim/README.md.
set -eu
SIM="${SIM:-sim}"
cd "$(dirname "$0")/sim"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
[ -f build/appa.elf ] || { echo "firmware missing: run sim/build.sh first" >&2; exit 1; }
mkdir -p out; rm -f out/flash.bin out/frames.txt; : > out/demo.log
S=""; for f in flash_init imu_init telemetry_init fc_state_update error_fail_fast; do S="$S --trace-symbol $f"; done
echo "Rev 2 flight computer + BMP390/BMI270/BMM150/SST25/SX1276 peers: simulating 15 s ..."
# script gives the sim a pty, so its output is line-buffered and reaches demo_view.py while it runs
SDR_LAUNCH_S=6 SDR_LORA=0 script -q out/demo.log "$SIM" run --scenario scenario.yaml --timeout 15 $S --trace-memory debug_handle \
  --frames out/frames.txt --frames-only i2c --ascii >/dev/null 2>&1 &
pid=$!
python3 demo_view.py out/demo.log out/flash.bin out/frames.txt "$pid"
wait "$pid"
echo "# run finished: 15 virtual s"
